---
import Basic from "../layouts/Basic.astro";
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0,1);
---
<style>
.post-card {
  display: inline-block;
  padding: 1rem;
  padding-left: 2rem;
  padding-right: 2rem;
  margin-right: 2rem;
  margin-left:2rem;
  margin-bottom: 1rem;
  background-color: var(--secondary-bg-color);
  color: var(--secondary-text-color);
  border-radius: 8px;
  text-decoration: none;
  width:fit-content;
  text-align:center;
}
.post-card:hover {
  background-color: var(--secondary-text-color);
  color: var(--secondary-bg-color);
}
</style>

<Basic title="Home">
	<h1 class="mainHeader">DessieOwO</h1>
	<h2 class="mainSubheader">Home of <em>The Barp</em></h2>
	<a href="/desmos" class="post-card">
		<h3>Desmos</h3>
		<p>My miscellaneous creations in Desmos.</p>
	</a>
	<hr>
	<h2>Latest Blog Post</h2>
	<p>Mostly just dumb jokes I want to share for whatever reason, but sometimes other stuff.</p>
	{posts.map((post) => (
    	<a href={`/blog/${post.id}`} class="post-card" style="display:block; margin:0rem;margin-bottom:1rem;text-align:left;">
    		<h3 >{post.data.title}</h3><p>({post.data.pubDate.toLocaleDateString()})</p>
    		{post.data.description && <p>&gt;&gt; {post.data.description}</p>}
    	</a>
  	))}
</Basic>
